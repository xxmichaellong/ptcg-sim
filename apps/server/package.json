{
  "name": "@ptcgsim/server-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "dev": "wrangler dev",
    "measure:runtime": "node performance/run-local-measurement.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/server/src",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "typecheck": "tsc --build && corepack pnpm run typecheck:model",
    "typecheck:model": "tsc --noEmit --project tsconfig.model-tests.json",
    "typecheck:runtime": "tsc --noEmit --project runtime-tests/tsconfig.json"
  },
  "dependencies": {
    "@ptcgsim/game-core": "workspace:*",
    "@ptcgsim/protocol": "workspace:*",
    "@ptcgsim/room-authority": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.3",
    "wrangler": "4.128.0"
  }
}
