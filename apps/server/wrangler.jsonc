{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ptcgsim-v2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BUILD_ID": "local-development",
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/v2/*",
      "!/v2/assets/cardback.png",
      "!/v2/assets/favicon.ico",
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PTCG_ROOM",
        "class_name": "PtcgRoom",
      },
      {
        "name": "PTCG_CONTINUATION",
        "class_name": "PtcgContinuation",
      },
      {
        "name": "PTCG_CONTINUATION_QUOTA",
        "class_name": "PtcgContinuationQuota",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATION_RATE_LIMITER",
      "namespace_id": "260903001",
      "simple": {
        "limit": 12,
        "period": 60,
      },
    },
    {
      "name": "CONTINUATION_CREATION_RATE_LIMITER",
      "namespace_id": "260903002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "CONTINUATION_RESTORE_RATE_LIMITER",
      "namespace_id": "260903003",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "CONTINUATION_REVOCATION_RATE_LIMITER",
      "namespace_id": "260903004",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "exports": {
    "PtcgContinuation": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "PtcgContinuationQuota": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "PtcgRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
  },
}
