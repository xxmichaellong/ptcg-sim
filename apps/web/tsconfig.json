{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./lib/.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "lib", "dist"],
  "references": [
    { "path": "../../packages/client-session" },
    { "path": "../../packages/game-core" },
    { "path": "../../packages/protocol" },
    { "path": "../../packages/renderer-contract" },
    { "path": "../../packages/renderer-dom" },
    { "path": "../../packages/renderer-pixi" }
  ]
}
