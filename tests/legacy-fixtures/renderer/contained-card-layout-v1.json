{
  "schemaVersion": 1,
  "recordingMethod": "Chromium 151 loads the checked-in legacy HTML/CSS with an allowlisted inert front-end module. The fixture transcribes Cover/resetImage output and records the current DOM; application/network modules are not executed. A live React DOM candidate is then compared against that source-backed geometry.",
  "scope": {
    "included": [
      "local and opponent deck/discard/lost-zone cover image sizing and rotation",
      "bottom-owner and top-owner stadium image sizing, alignment, and rotation",
      "deck-first versus discard/lost-zone-last pile-top identity",
      "closed-cover suppression of lower-card input and cover-pile ability markers",
      "stadium maximum cardinality and owner-readable orientation"
    ],
    "excluded": [
      "cover click opening a zone",
      "opened-zone card layout and interaction",
      "exact no-upscale behavior for undersized or noncanonical production assets",
      "browser candidate comparison of the top-owner stadium branch",
      "quarter-turn hit regions for 90-degree and 270-degree cards",
      "replacing retained covered scene nodes with one physical renderer node"
    ]
  },
