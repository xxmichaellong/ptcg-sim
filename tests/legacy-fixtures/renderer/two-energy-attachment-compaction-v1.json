  "scope": {
    "included": [
      "exactly two ordinary face-up Energy attached in canonical order to one unrotated active Pokémon",
      "independent inner-first and outer-second Energy departure branches for local and opponent active at the default 1600x900 DPR-1 sidebar layout",
      "stable pre-departure, immediate post-departure, synchronous post-refresh, and observer-settled stable post-refresh phases",
      "legacy parseInt compaction, integer CSSOM clientWidth wrapper shrink, refreshed clientWidth/6 attachment offset, and adjustCards wrapper width",
      "card identity, logical order, DOM order, relative/target/layer state, authored and client wrapper widths, bounds, rotations, z order, four safe interior hit orders, and real asynchronous empty-wrapper cleanup"
    ],
    "excluded": [
      "Trainer-as-Tool, mixed attachment types, and Tool rotation or margin behavior",
      "three or more attachments, Pokémon-classified attachments, evolution layers, and noncanonical attachment order",
      "base departure, attachment transfer, reattachment, staging, and attachedCards popup behavior",
      "bench, multiple stacks, flex shrink, overflow, resize, fullscreen, and explicit board flip",
      "damage, ability, special-condition, BREAK, group rotation, and per-card rotation",
      "mixed or noncanonical card dimensions and concealed card metadata",
      "face-down, reveal, hide, and source mutation behavior",
      "previews, click, drag, context-menu, message, network, and server behavior",
      "candidate DOM/Pixi parity and production renderer correctness",
      "the synchronous ghost wrapper as a stable or user-visible rendered result"
    ]
  },
