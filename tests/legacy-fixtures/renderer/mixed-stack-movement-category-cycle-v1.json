  "scope": {
    "included": [
      "one unrotated face-up Pokémon base with one ordinary face-up Energy and one current-category face-up Trainer-as-Tool, plus one ordinary base-only active/bench control",
      "native canonical active construction, previously pinned reverse-restored drift seeded as the movement precondition, active-to-occupied-bench no-target auto-promotion, and targeted return to occupied active on both physical sides",
      "Energy to Trainer to Energy and Trainer to Energy to Trainer current-category cycles through changeType board departure and ordinary reattachment",
      "logical/direct DOM identity and order, current/original categories, parent wrapper and zone, wrapper width/client width/margin/layers, painted and pre-transform bounds, local/effective rotations, z, safe hit order, exact harness operation/reset trace, synchronous ghost wrappers, two-frame cleanup, and deny-by-default source fulfillment"
    ],
    "excluded": [
      "production React DOM or Pixi parity and any claim that legacy transient ghost-wrapper placement is a candidate-renderer requirement",
      "more than one Energy or Trainer-as-Tool, evolution attachments, Pokémon-category conversion defects, face-down cards, damage, condition, ability, counters, BREAK, and heterogeneous card dimensions",
      "bench-to-bench reordering, more than one bench control, explicit case-3 active/bench target replacement, resize, fullscreen, explicit board flip, pointer gestures, server, messaging, and network behavior",
      "intermediate loose-board category-cycle geometry; exact changeType/moveCard/reset traces and the immediate plus observer-settled final active stack are pinned instead",
      "re-execution of leaveAll in this fixture; the seeded reverse-restored starting geometry is independently pinned by mixed-energy-trainer-tool-attachment-order-v1"
    ]
