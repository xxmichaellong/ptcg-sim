{
  "schemaVersion": 1,
  "recordingMethod": "Manually reviewed Chromium 151 CSS-pixel capture of four isolated, source-pinned DOM replays of the checked-in ordinary moveCardBundle -> evolveCard -> refreshBoard path. The legacy HTML, CSS, and cardback asset are loaded directly; application/network modules remain inert, and their relevant mutation logic is narrowly transcribed. The transient evolve output is diagnostic only. Stable geometry is captured after the empty-wrapper MutationObserver settles across two animation frames.",
  "input": {
    "viewport": { "width": 1600, "height": 900, "devicePixelRatio": 1 },
    "asset": {
      "path": "/src/assets/cardback.png",
      "naturalWidth": 736,
      "naturalHeight": 1024
    },
    "canonicalEvolutionOrder": ["base", "middle", "top"],
    "cases": [
      "local-active",
      "local-bench",
      "opponent-active",
      "opponent-bench"
    ]
  },
  "tolerances": {
    "anchorPixels": 2,
    "cardSizeRelative": 0.01,
    "rotationDegrees": 0.1,
    "structuredPixels": 0.0001
  },
  "scope": {
    "included": [
      "ordinary attachment-free second evolution onto an existing two-card Pokémon chain",
      "unrotated portrait cards in otherwise empty local/opponent active and bench zones",
      "the synchronous post-evolve diagnostic state and the settled post-refresh state",
      "integer CSSOM clientWidth offsets, legacy logical/DOM order, paint/hit order, wrapper margins, and asynchronous empty-wrapper cleanup"
    ],
    "excluded": [
      "Energy, Trainer, Tool, and unrelated Pokémon attachments",
      "damage, ability, and special-condition counters",
      "BREAK cards, per-card rotation, group rotation, and quarter-turn bounds",
      "mixed or noncanonical card dimensions and concealed card metadata",
      "face-down, reveal, hide, and source mutation behavior",
      "multiple bench stacks, flex shrink, overflow, and cross-stack overlap",
      "resize, fullscreen, explicit board flip, and physical ownership changes",
      "active/bench transfers, promotion, swapping, departure, removal, and lower-layer removal",
      "leaveAll restoration and other history-dependent reconstruction paths",
      "previews, click, drag, context-menu, message, network, and server behavior",
      "candidate DOM/Pixi parity and production renderer correctness",
      "the synchronous ghost wrapper as a stable or user-visible rendered result"
    ]
  },
