    "anchorPixels": 2,
    "cardSizeRelative": 0.01,
    "rotationDegrees": 0.1,
    "structuredPixels": 0.001
  },
  "scope": {
    "included": [
      "one native/current-category Trainer attached as a Tool to one ordinary face-up unrotated non-BREAK Pokémon",
      "isolated local and opponent active slots at the default 1600x900 DPR-1 sidebar layout",
      "the immediate post-attach diagnostic state and stable post-refresh state",
      "integer CSSOM clientWidth/6 offset, stable adjustCards wrapper width, inline 2% right margin, and empty left margin",
      "Trainer presentation-only quarter-turn, transformed painted box, synchronously measured untransformed layout box, matrix, and transform origin",
      "single-Tool rotated paint overflow beyond the authored wrapper",
      "logical order, DOM order, attachment target/relative/energyLayer state, z order, common/Tool-only/base-only/empty authored-layout hit order, and asynchronous empty-wrapper cleanup",
      "the legacy UI convention that its Tool action reclassifies the current card category to Trainer"
    ],
    "excluded": [
      "rules-aware Pokémon Tool validation or a distinct Tool card category",
      "Energy, multiple or mixed attachments, Trainer ordering, and attachment-order normalization",
      "Pokémon evolution layers and Pokémon-classified attachments",
      "attachment departure, compaction, transfer, staging, history-dependent reconstruction, and stale post-removal margins",
      "bench, multiple stacks and their flex shrink/overflow interactions, resize, fullscreen, alternate layouts, and explicit board flip",
      "damage, ability, special-condition, BREAK, group rotation, nonzero base rotation, and manual Tool rotation",
      "native-versus-reclassified Trainer history, mixed or noncanonical card dimensions, and cross-owner placement",
      "concealed card metadata, face-down, reveal, hide, and source mutation behavior",
      "previews, click, drag, drop, context-menu, message, network, and server behavior",
      "candidate DOM/Pixi parity, production renderer correctness, and rotation-aware shared interaction semantics",
      "the synchronous ghost wrapper as a stable or user-visible rendered result"
    ]
  },
